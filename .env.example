# Enhanced EmpathyWave Configuration
# Copy this file to .env and modify as needed

# Gemini AI Configuration
GEMINI_API_KEY=AIzaSyDj7wyPs73Nxmrnqo0H1PyLx_iUwC-XwQk

# Flask Configuration
SECRET_KEY=empathy-wave-enhanced-secret-key-2024
FLASK_ENV=development
FLASK_DEBUG=True

# Server Configuration
HOST=0.0.0.0
PORT=5000

# Model Paths
TEXT_MODEL_PATH=data/models/text_model.pkl
AUDIO_MODEL_PATH=data/models/audio_model.pkl

# Audio Processing Settings
AUDIO_SAMPLE_RATE=16000
MAX_AUDIO_DURATION=30
AUDIO_CHUNK_SIZE=1024

# Analysis Settings
RISK_THRESHOLD_LOW=0.3
RISK_THRESHOLD_HIGH=0.7
CONFIDENCE_THRESHOLD=0.5

# Chat Settings
MAX_CHAT_HISTORY=50
SESSION_TIMEOUT=3600

# Security Settings
RATE_LIMIT_PER_MINUTE=30
MAX_MESSAGE_LENGTH=1000
ALLOWED_AUDIO_FORMATS=wav,mp3,ogg,m4a

# UI Settings
THEME_PRIMARY_COLOR=#667eea
THEME_SECONDARY_COLOR=#764ba2
ANIMATION_SPEED=0.3s
ENABLE_ANIMATIONS=True
ENABLE_AUDIO_FEATURES=True
ENABLE_SIDEBAR=True

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/empathy_wave.log